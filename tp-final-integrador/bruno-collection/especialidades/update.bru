  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "nombre": "PEDIATRÍA MODIFICADA",
    "activo": true
  }
}

docs {
  Actualiza los datos de una especialidad.
  Acceso: Solo Admin.
