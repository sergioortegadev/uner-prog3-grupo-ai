meta {
  name: Get All
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/especialidades
  body: none
  auth: none
}

params:query {
  ~nombre: pediatra
  ~activo: 1
  ~limit: 10
  ~offset: 0
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  Lista todas las especialidades. Soporta filtros por nombre y estado, paginación y orden.
  Acceso: Paciente / Admin.
}
